# ============================================================================
# ABA Foundation — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Database (PostgreSQL on Supabase) --------------------------------------
# Supabase → Project Settings → Database → Connection string.
#
# NOTE: these are the Postgres connection strings, NOT the Supabase API keys
# (NEXT_PUBLIC_SUPABASE_URL / *_PUBLISHABLE_KEY). We don't use the Supabase
# browser SDK, Supabase Auth or RLS — see the DB provider note in
# AGENT_BUILD_SPEC.md.
#
# DATABASE_URL = "Transaction pooler" (port 6543). What the app uses at
#   runtime; required on serverless/Vercel, where each request may open its
#   own connection.
# DIRECT_URL  = "Direct connection" / session pooler (port 5432). Used only by
#   drizzle-kit migrations and the seed script — DDL needs a real session.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth.js (NextAuth) — Phase 1 ------------------------------------------
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Email (Resend) — Phase 3 ----------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="ABA Foundation <hello@yourdomain.org>"

# --- File storage (S3-compatible) — Phase 2 --------------------------------
# Activity media and donation payment-proof screenshots.
# Supabase Storage is S3-compatible: set S3_ENDPOINT to
#   https://PROJECT.supabase.co/storage/v1/s3
# and use the storage access keys. Leave S3_ENDPOINT blank for AWS S3.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# --- Error tracking (Sentry) — Phase 5 -------------------------------------
SENTRY_DSN=""

# --- Seed: the first Admin user (`npm run db:seed`) ------------------------
# Used once, locally. Change the password immediately after first sign-in.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_PASSWORD=""
# Break glass: set to true to RESET an existing admin password (no reset email yet).
# SEED_ADMIN_FORCE_PASSWORD=true
